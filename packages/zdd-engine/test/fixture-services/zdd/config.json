{
  "name": "Fixture Services",
  "baseBranch": "main",
  "extractors": ["fastapi", "external-services"],
  "render": { "storeChanges": false },
  "extractorOptions": {
    "fastapi": { "roots": ["apps/api"] },
    "external-services": {
      "services": [
        { "name": "Sentry", "imports": ["sentry_sdk", "@sentry/react"], "env": ["SENTRY_"] },
        { "name": "Resend", "env": ["RESEND_"] },
        { "name": "Unused", "imports": ["nothing_imports_this"] }
      ],
      "ignore": ["MAPBOX"]
    }
  }
}
