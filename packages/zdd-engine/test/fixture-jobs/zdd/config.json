{
  "name": "Fixture Jobs",
  "baseBranch": "main",
  "extractors": [
    "supabase",
    "supabase-js",
    "supabase-py",
    "sqlalchemy",
    "nextjs",
    "jobs"
  ],
  "render": {
    "storeChanges": false
  },
  "extractorOptions": {
    "supabase": {
      "migrationNamespaces": [
        {
          "name": "db",
          "dir": "supabase/migrations"
        }
      ]
    },
    "jobs": {
      "modes": {
        "worker": "worker"
      }
    },
    "nextjs": {
      "appDir": "apps/web/src/app",
      "refs": {
        "roots": [
          "apps/web/src"
        ]
      }
    },
    "supabase-py": {
      "roots": [
        "apps/api"
      ]
    },
    "sqlalchemy": {
      "roots": [
        "apps/api"
      ]
    }
  }
}
